# ============================================================
# SOFA AI Security Gateway — Environment Configuration (.env)
# ============================================================
# Copy this file to .env and configure for your environment.

# --- 1. Cloud AI Backend (NORMAL Route) ---
# High-speed cloud AI provider (e.g. Groq Cloud API, OpenAI, Google Gemini)
NORMAL_BACKEND_URL=https://api.groq.com/openai/v1
NORMAL_BACKEND_API_KEY=gsk_your_cloud_api_key_here
NORMAL_BACKEND_MODEL=qwen/qwen3.8-27b
NORMAL_BACKEND_TIMEOUT=60

# --- 2. Offline Neural Guard Model (Local Llama-Guard-3-1B) ---
# Absolute path or HuggingFace ID for offline local neural inference
LLAMA_GUARD_MODEL_PATH=E:/models/Llama-Guard-3-1B

# --- 3. Air-Gapped Isolated Shield Environment (SHIELD Route) ---
# Local offline LLM server (vLLM / Ollama / Local Runtime)
SHIELD_MODE=local_isolated
SHIELD_LOCAL_LLM_URL=http://localhost:8100/v1
SHIELD_LOCAL_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
SHIELD_REQUEST_TIMEOUT=120

# --- 4. Centralized Security Knowledge Catalog ---
# Path to declarative security rules, DLP regexes, and lexicons
SECURITY_KNOWLEDGE_DIR=./security_knowledge
CONFIDENCE_THRESHOLD=0.50

# --- 5. Observability & Logging ---
LOG_LEVEL=INFO

