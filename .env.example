# ============================================================
# Secure AI Gateway — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.

# --- Authentication ---
# Comma-separated list of valid API keys
GATEWAY_API_KEYS=sk-test-key-1,sk-test-key-2

# --- Rate Limiting ---
# Maximum requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# --- Normal Backend (Cloud AI Flow) ---
# For Google Gemini (OpenAI-compatible endpoint):
NORMAL_BACKEND_URL=https://generativelanguage.googleapis.com/v1beta/openai
NORMAL_BACKEND_API_KEY=AIzaSy_your_gemini_api_key_here
NORMAL_BACKEND_MODEL=gemini-1.5-flash

# --- Shield Service ---
# URL of the Shield service (for restricted requests)
SHIELD_SERVICE_URL=http://localhost:8001

# --- Local LLM (used by Shield) ---
# vLLM or any OpenAI-compatible local LLM server
LOCAL_LLM_URL=http://localhost:8100/v1
LOCAL_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- Rules ---
# Path to rules directory
RULES_DIR=./security_knowledge/ingress

# --- Logging ---
LOG_LEVEL=INFO
